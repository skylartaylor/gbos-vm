+/* Look the resource up, dup its fd and read its size under resource_mutex, so a
+ * concurrent DESTROY_RESOURCE cannot free it underneath us, and check the size
+ * against the real shm object before mapping it. */
+static struct vkr_shm *
+vkr_shm_import(struct vkr_context *ctx, uint32_t res_id, uint64_t requested_size)
+{
+   int fd = -1;
+   size_t size = 0;
+   mtx_lock(&ctx->resource_mutex);
+   const struct hash_entry *entry = _mesa_hash_table_search(ctx->resource_table, &res_id);
+   const struct vkr_resource *res = entry ? entry->data : NULL;
+   if (res && res->fd_type == VIRGL_RESOURCE_FD_SHM && res->shm_fd >= 0) {
+      fd = os_dupfd_cloexec(res->shm_fd);
+      size = res->size;
+   }
+   mtx_unlock(&ctx->resource_mutex);
+   struct stat st;
+   if (fd < 0 || !size || requested_size > size || size % getpagesize() ||
+       fstat(fd, &st) || st.st_size < 0 || (uint64_t)st.st_size < size) {
+      if (fd >= 0)
+         close(fd);
+      return NULL;
+   }
+   struct vkr_shm *shm = calloc(1, sizeof(*shm));
+   if (!shm) {
+      close(fd);
+      return NULL;
+   }
+   shm->fd = fd;
+   shm->size = size;
+   shm->ptr = mmap(NULL, shm->size, PROT_READ | PROT_WRITE, MAP_SHARED, shm->fd, 0);
+   if (shm->ptr == MAP_FAILED) {
+      close(shm->fd);
+      free(shm);
+      return NULL;
+   }
+   return shm;
+}
